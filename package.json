{
  "name": "weathertower",
  "version": "2.1.2",
  "description": "Broadcast weather overlays with verified observations and durable local storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:offline": "node scripts/start-offline.js",
    "start:supervised": "node scripts/supervisor.js",
    "build": "node scripts/build-assets.js",
    "postinstall": "node scripts/build-assets.js",
    "test": "node --test test/*.test.js",
    "backup": "node scripts/backup.js",
    "soak": "node scripts/soak.js",
    "format": "prettier --write server.js src public/js public/css public/*.html scripts test",
    "format:check": "prettier --check server.js src public/js public/css public/*.html scripts test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/noto-sans-tc": "5.3.0",
    "@supabase/supabase-js": "2.97.0",
    "chart.js": "4.5.1",
    "dotenv": "17.3.1",
    "express": "5.2.1"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
