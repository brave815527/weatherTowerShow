# Local playback is safe: no Weather API calls and no cloud writes.
APP_MODE=playback
HOST=127.0.0.1
PORT=3005
STATION_NAME=吉安氣象觀測站
STATION_ID=
EXPECTED_INTERVAL_SECONDS=300
POLL_SECONDS=60
REQUEST_TIMEOUT_MS=8000
RETENTION_DAYS=30
DATA_DIR=./data
DEMO_ENABLED=true
# Required only for live collection. Use metric units and your own key.
WEATHER_API_URL=
# Optional for cloud history / uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
